        <div class='style-guide__colours-wrapper'>
          <div class='style-guide__colours-box'>
            <div
              class='style-guide__colours-background style-guide__colours--quinary'
            ></div>
          </div>
          <p class='style-guide__colours-content'>
            {{ 'style_guide.off_site' | t }}
          </p>
        </div>
      </div>
      <div class='style-guide__colours-item'>
        <h5 class='style-guide__colours-headline'>
          {{ 'style_guide.functional' | t }}
