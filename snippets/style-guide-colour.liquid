<section class='style-guide__section'>
  <div class='style-guide__section-header'>
    <div class='container'>
      <h3 class='style-guide__section-header-title'>
        {{ 'style_guide.colors' | t }}
      </h3>
    </div>
  </div>
  <div class='style-guide__section-content'>
    <div class='container'>
      <div class='style-guide__colours-item'>
        <h5 class='style-guide__colours-headline'>
          {{ 'style_guide.brand' | t }}
        </h5>
        <div class='style-guide__colours-wrapper'>
          <div class='style-guide__colours-box'>
            <div
              class='style-guide__colours-background style-guide__colours--primary'
            ></div>
          </div>
          <p class='style-guide__colours-content'>
            {{ 'style_guide.color_names.black' | t }}
          </p>
        </div>
        <div class='style-guide__colours-wrapper'>
          <div class='style-guide__colours-box'>
            <div
              class='style-guide__colours-background style-guide__colours--secondary'
            ></div>
          </div>
          <p class='style-guide__colours-content'>
            {{ 'style_guide.color_names.yellow' | t }}
          </p>
        </div>
        <div class='style-guide__colours-wrapper'>
          <div class='style-guide__colours-box'>
            <div
              class='style-guide__colours-background style-guide__colours--tertiary'
