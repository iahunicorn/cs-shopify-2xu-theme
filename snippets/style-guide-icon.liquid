<section class='style-guide__section'>
  <div class='style-guide__section-header'>
    <div class='container'>
      <h3 class='style-guide__section-header-title'>
        {{ 'style_guide.icon' | t }}
      </h3>
    </div>
  </div>
  <div class='style-guide__section-content'>
    <div class='container'>
      <div class='grid grid--2 style-guide__section-content'>
        <div class='grid__item '>
          <div class='style-guide__section-icons'>
            {%- liquid
              render 'icon' with 'cart'
              render 'icon' with 'arrow-forward'
              render 'icon' with 'minus'
              render 'icon' with 'plus'
              render 'icon' with 'chevron-back'
              render 'icon' with 'chevron-forward'
              render 'icon' with 'chevron-forward-outline'
              render 'icon' with 'chevron-down'
              render 'icon' with 'chevron-down-outline'
              render 'icon' with 'menu'
              render 'icon' with 'close'
              render 'icon' with 'search'
              render 'icon' with 'person'
              render 'icon' with 'instagram'
              render 'icon' with 'call'
              render 'icon' with 'heart-outline'
              render 'icon' with 'arrow-back-outline'
              render 'icon' with 'map'
              render 'icon' with 'filter'
              render 'icon' with 'information-outline'
              render 'icon' with 'afterpay'
              render 'icon' with 'klarna'
              render 'icon' with 'wallet'
              render 'icon' with 'location-outline'
            -%}
          </div>
          <div
            class='style-guide__section-icons'
            style='margin-top: 29px;background: #EFB0D5; padding: 16px 23px;'
          >
            {%- render 'icon' with 'close-outline' -%}
            {%- render 'icon' with 'facebook' -%}
            {%- render 'icon' with 'location' -%}
            {%- render 'icon' with 'help-circle' -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
