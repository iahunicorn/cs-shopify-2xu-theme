<div class="PageLayout__Section Page--orders">
  {%- if customer.orders.size == 0 -%}
    <div class="Segment">
      <h2 class="Segment__Title Heading u-h7">{{ 'customer.account.no_orders_title' | t }}</h2>

      <div class="Segment__Content">
        <p>{{ 'customer.account.no_orders_content' | t }}</p>
      </div>
    </div>
  {%- else -%}
    {%- paginate customer.orders by 25 -%}
      <div class="TableWrapper desktop-orders-table">
        <table class="AccountTable Table Table--large">
          <thead class="Text--subdued">
            <tr>
              <th>{{ 'customer.orders.order_number' | t }}</th>
              <th>{{ 'customer.orders.date' | t }}</th>
              <th>{{ 'customer.orders.payment_status' | t }}</th>
              <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
              <th class="Text--alignRight">{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>

          <tbody class="Heading u-h7">
            {%- for order in customer.orders -%}
              <tr>
                <td><a href="{{ order.customer_url }}" class="Link Link--underline">{{ order.name }}</a></td>
                <td>{{ order.created_at }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td class="Text--alignRight">{{ order.total_price | money_without_trailing_zeros }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      {% comment %} Mobile Order Table {% endcomment %}
      <div class="TableWrapper mobile-orders">
        {% assign customLine = 0 %}
        {%- for order in customer.orders -%}
          {% assign customLine = customLine | plus: 1 %}
          <table class="mobile-orders-table" >
            <tbody class="Heading u-h7">
                <tr>
                  <td class="header-orders">{{ 'customer.orders.order_number' | t }}</td>
                  <td><a href="{{ order.customer_url }}" class="Link Link--underline">{{ order.name }}</a></td>
                </tr>
                <tr>
                  <td class="header-orders">{{ 'customer.orders.date' | t }}</td>
                  <td>{{ order.created_at }}</td>
                </tr>
                <tr>
                  <td class="header-orders">{{ 'customer.orders.payment_status' | t }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  </tr>
                <tr>
                  <td class="header-orders">{{ 'customer.orders.fulfillment_status' | t }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                </tr>
                <tr>
                  <td class="header-orders">{{ 'customer.orders.total' | t }}</td>
                  <td>{{ order.total_price | money_without_trailing_zeros }}</td>
                </tr>
                <hr class="mobile-orders-line-{{ customLine }}"/>
            </tbody>

          </table>
          {%- endfor -%}
      </div>

      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>
