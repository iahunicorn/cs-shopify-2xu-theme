[
  {%- assign size_variants = '' -%}
  {%- for variant in product.variants -%}
    {%- assign size_option_index = -1 -%}
    {%- for option_name in product.options -%}
      {%- assign option_lower = option_name | downcase -%}
      {%- if option_lower == 'size' or option_lower == 'sizes' -%}
        {%- assign size_option_index = forloop.index0 -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    
    {%- if size_option_index >= 0 -%}
      {%- if size_variants != '' -%},{%- endif -%}
      {
        "name": {{ variant.options[size_option_index] | json }},
        "id": "{{ variant.id }}",
        "available": {{ variant.available | json }}
      }
      {%- assign size_variants = size_variants | append: '1' -%}
    {%- endif -%}
  {%- endfor -%}
]