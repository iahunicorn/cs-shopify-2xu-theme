

{% comment %} 

	Params:
		settings; section.settings

	Type:
		title: string
		image_desktop: image
		image_mobile: image


 {% endcomment %}

<div class="account-promo-background">
	{% comment %} {% if settings.image_mobile != blank %}
		<a href="{{ section.settings.link_banner }}">

		</a>
	{% endif %} {% endcomment %}
	{% if settings.image_desktop != blank %}
			<a href="{{ section.settings.link_banner }}">
				<picture>
					<source
						srcSet="{{ settings.image_desktop | img_url: 'master' }}"
						media="(min-width: 1000px)"
					>
					<img {% if settings.image_mobile.presentation.focal_point %}style="object-position:{{ settings.image_mobile.presentation.focal_point }};"{% endif %} src="{{ settings.image_mobile | img_url: '750x', scale: 2 }}" />
				</picture>

			</a>
	{% endif %}
</div>


