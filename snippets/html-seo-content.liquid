{% comment %}
  SEO Content Component for Collection Pages
  Uses metafield: custom.seo_content_columns (list of seo_column metaobjects)
  Metaobject fields: seo_column.heading, seo_column.body
{% endcomment %}

{% if collection.metafields.custom.seo_content_columns.value %}
  <section class="tw-px-4 lg:tw-px-12 tw-pb-14">
    <div class="tw-max-w-7xl tw-mx-auto">
      <div class="tw-bg-2xu-light-grey tw-rounded-lg tw-py-4 lg:tw-py-20 tw-px-4 lg:tw-px-14">
        <div class="tw-grid tw-grid-cols-1 lg:tw-grid-cols-2 tw-gap-8 lg:tw-gap-32">
          {% for column in collection.metafields.custom.seo_content_columns.value %}
            <div class="tw-space-y-4">
              {% if column.heading %}
                <h2 class="tw-font-euclid tw-normal-case tw-text-xl tw-text-2xu-black tw-mb-4">
                  {{ column.heading }}
                </h2>
              {% endif %}
              
              {% if column.body %}
                <div class="tw-font-euclid">
                  {{ column.body | metafield_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{% endif %}