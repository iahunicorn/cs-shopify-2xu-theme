<section class='style-guide__section'>
  <div class='style-guide__section-header'>
    <div class='container'>
      <h3 class='style-guide__section-header-title'>
        {{ 'style_guide.typography' | t }}
      </h3>
    </div>
  </div>
  <div class='style-guide__section-content'>
    <div class='container'>
      <div class='grid grid--2'>
        <div class='grid__item'>
          <h5 class='style-guide__section-title'>
            {{ 'style_guide.headings' | t }}
          </h5>
          <h1 class='style-guide__section-heading'>
            {{ 'style_guide.heading' | t }} 1
          </h1>
          <h2 class='style-guide__section-heading'>
            {{ 'style_guide.heading' | t }} 2
          </h2>
          <h3 class='style-guide__section-heading'>
            {{ 'style_guide.heading' | t }} 3
          </h3>
          <h4 class='style-guide__section-heading'>
            {{ 'style_guide.heading' | t }} 4
          </h4>
          <h5 class='style-guide__section-heading'>
            {{ 'style_guide.heading' | t }} 5
          </h5>
          <h6 class='style-guide__section-heading'>
            {{ 'style_guide.heading' | t }} 6
          </h6>
        </div>
        <div class='grid__item'>
          <h5 class='style-guide__section-title'>
            {{ 'style_guide.paragraph' | t }}
          </h5>
          <p class='style-guide__paragraph'>
            {{ 'style_guide.paragraph_text' | t }}
          </p>
          <h5 class='style-guide__section-title'>
            {{ 'style_guide.large_paragraph' | t }}
          </h5>
          <p class='style-guide__paragraph p--large'>
            {{ 'style_guide.large_paragraph_text' | t }}
          </p>
          <h5 class='style-guide__section-title'>
            {{ 'style_guide.text_links' | t }}
          </h5>
          <div class='style-guide__text-link'>
            <a class='link' href='#'>{{ 'style_guide.text_link' | t }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
