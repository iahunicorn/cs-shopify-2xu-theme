{% if shop.permanent_domain == 'uk-2xu.myshopify.com' %}
  {% include 'shogun-content-handler' %}
{% endif %}
<!doctype html>
<html class='no-js' lang='{{ request.locale.iso_code }}'>
  <head>
    {% if shop.permanent_domain == '2xu-australia.myshopify.com' %}
      <script src="https://cdn.logr-in.com/LogRocket.min.js" crossorigin="anonymous"></script>
      <script>window.LogRocket && window.LogRocket.init('m1ds3j/2xu');</script>
    {% endif %}
    {% if shop.permanent_domain == 'uk-2xu.myshopify.com' %}
      {% render 'pandectes-rules' %}
    {% endif %}
    {% if shop.permanent_domain == '2xu-australia.myshopify.com' %}
      {%- render 'ecom_header' -%}
    {% endif %}
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <meta
      name='viewport'
      content='width=device-width,initial-scale=1,maximum-scale=1'
    >
    <meta name='theme-color' content=''>
    <script
      type='text/javascript'
      src='https://preeziecdn.azureedge.net/production/preguide.min.js'
    ></script>
    <link rel='canonical' href='{{ canonical_url }}'>
    <link rel='preconnect' href='https://cdn.shopify.com' crossorigin>
    {%- if settings.favicon != blank -%}
      <link
        rel='icon'
        type='image/png'
        href='{{ settings.favicon | image_url: width: 32, height: 32 }}'
      >
    {%- endif -%}

    {%- unless settings.type_header_font.system?
      and settings.type_body_font.system?
    -%}
      <link rel='preconnect' href='https://fonts.shopifycdn.com' crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' }}"
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %}
        &ndash; {{ shop.name -}}
      {%- endunless -%}
    </title>

    {% if page_description %}
      <meta name='description' content='{{ page_description | escape }}'>
    {% endif %}

    {% render 'meta-tags' %}
    {% if shop.permanent_domain == '2xu-australia.myshopify.com' %}
      {% render 'VWO-script' %}
      {% comment %} Zipy g4a {% endcomment %}
      {% render 'zipy-script' %}
    {% endif %}
    {% if shop.permanent_domain == '2xu-us.myshopify.com' %}
      {% render 'VWO-script-US' %}
    {% endif %}

    <script src='{{ 'global.js' | asset_url }}' defer='defer'></script>
    {% capture CFH %}{{ content_for_header  }}{% endcapture %}
    {{ CFH }}
    {% assign isAdmin = false %}
    {% if CFH contains 'adminBarInjector' or CFH contains 'admin_bar_iframe' %}
      {% assign isAdmin = true %}
    {% endif %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'template-index.css' | asset_url | stylesheet_tag }}
    {{ 'section-card.css' | asset_url | stylesheet_tag }}
    {% if request.page_type == 'collection'
      or request.page_type == 'product'
      or request.page_type == 'index'
    %}
      <link rel='stylesheet' href='{{ 'swatches.scss.css' | asset_url }}'>
    {% endif %}

    {%- render 'theme-settings' -%}

    {%- render 'theme-styles' -%}

    {%- if template contains 'account' -%}
      {{ 'account.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {%- if page.template_suffix == 'prismic' -%}
      {{ 'page.prismic.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel='stylesheet'
        href='{{ 'component-predictive-search.css' | asset_url }}'
        media='print'
        onload="this.media='all'"
      >
    {%- endif -%}

    <script>
      document.documentElement.className =
        document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
    {% comment %} {%- render 'regionalisation', isAdmin: isAdmin -%} {% endcomment %}
    {% if settings.ss_enable %}
      {% render 'ss-script' %}
    {% endif %}
    {% if shop.permanent_domain == '2xu-australia.myshopify.com' %}
      
      {% render 'shogun-head' %}
    {% endif %}

    {% render 'wunderkind' %}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}
    {% liquid
      # Relative to entrypointsDir
      render 'vite-tag' with 'theme.css'
      render 'vite-tag' with 'theme.js'
      if template.name == 'index' or template.name == 'page'
        render 'vite-tag' with 'page.js'
      endif
    %}
    <script>
      window.markerConfig = {
        project: '67186d1a9a04f3051106d712',
        source: 'snippet',
      };

      !(function (e, r, a) {
        if (!e.__Marker) {
          e.__Marker = {};
          var t = [],
            n = { __cs: t };
          [
            'show',
            'hide',
            'isVisible',
            'capture',
            'cancelCapture',
            'unload',
            'reload',
            'isExtensionInstalled',
            'setReporter',
            'clearReporter',
            'setCustomData',
            'on',
            'off',
          ].forEach(function (e) {
            n[e] = function () {
              var r = Array.prototype.slice.call(arguments);
              r.unshift(e), t.push(r);
            };
          }),
            (e.Marker = n);
          var s = r.createElement('script');
          (s.async = 1), (s.src = 'https://edge.marker.io/latest/shim.js');
          var i = r.getElementsByTagName('script')[0];
          i.parentNode.insertBefore(s, i);
        }
      })(window, document);
    </script>
    {% comment %}
      {% for language in localization.available_languages %}
        <link
          rel='alternate'
          hreflang='{{ language.iso_code }}'
          href='{{ canonical_url }}'
        >
      {% endfor %}
    {% endcomment %}
    {% render 'hreflang' %}
  </head>

  {% if shop.permanent_domain == '2xu-jp.myshopify.com' %}
    {% assign isJapanStore = 'is-jp' %}
  {% endif %}

  <body
    class='
      gradient page-{{ template.name | handle }}
      {% if cart == empty %}cart-empty{% endif %}
      {% if settings.ss_enable and collection.handle and collection.handle == settings.ss_collection_handle %} ss-shop{% endif %} {{ isJapanStore }}
    '
  >
    <geo-location-modal
      data-shop-country='test'
      data-available-countries='{{ localization.available_countries | json }}'
      data-permanent-domain='{{ shop.permanent_domain }}'
      data-countries-list='
        [
          {% for country in settings.countries %}
            {
              "name": "{{ country.full_name }}",
              "code": "{{ country.iso_code }}",
              "currency": "{{ country.currency }}",
              "flag": "{{ country.flag | image_url }}",
              "link": "{{ country.link }}",
              "allocations": {% if country.allocations %}{{ country.allocations }}{% else %}[]{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      '
      data-default-country='
        {
          "name": "{{ settings.default_localisation_country.full_name }}",
          "code": "{{ settings.default_localisation_country.iso_code }}",
          "currency": "{{ settings.default_localisation_country.currency }}",
          "flag": "{{ settings.default_localisation_country.flag | image_url }}",
          "link": "{{ settings.default_localisation_country.link }}",
          "allocations": {% if settings.default_localisation_country.allocations %}{{ settings.default_localisation_country.allocations }}{% else %}[]{% endif %}
        }
      '
      data-labels='
        {
          "current": "{{ settings.localisation_current_label  | escape}}",
          "suggested": "{{ settings.localisation_suggested_label | escape }}",
          "current_location_heading": "{{ settings.localisation_current_location_heading  | escape}}",
          "select_country_heading": "{{ settings.localisation_select_country_heading  | escape}}",
          "choose_destination_button_text": "{{ settings.localisation_choose_destination_button_text | escape }}"
        }
      '
    ></geo-location-modal>
    
    <script>
      window.KlarnaThemeGlobals = {};

      {% case template.name %}
        {% when "product" %}
          {% if product.first_available_variant.price %}
              window.KlarnaThemeGlobals.data_purchase_amount = {{ product.first_available_variant.price }};
          {% endif %}
          window.KlarnaThemeGlobals.productVariants = {{ product.variants | json }};
          window.KlarnaThemeGlobals.documentCopy = document.cloneNode(true);
        {% when "cart" %}
            window.KlarnaThemeGlobals.data_purchase_amount = {{ cart.total_price }};
            window.KlarnaThemeGlobals.documentCopy = document.cloneNode(true);
      {% endcase %}
    </script>

    

    <a class='skip-to-content-link button visually-hidden' href='#MainContent'>
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {% section 'topbar' %}
    {% section 'header' %}
    <main
      id='MainContent'
      class='content-for-layout focus-none'
      role='main'
      tabindex='-1'
    >
      {{ content_for_layout }}
    </main>
    
    
    
    

    

    <ul hidden>
      <li id='a11y-refresh-page-message'>
        {{ 'accessibility.refresh_page' | t }}
      </li>
      <li id='a11y-new-window-message'>
        {{ 'accessibility.link_messages.new_window' | t }}
      </li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
      };
    </script>

    {%- if settings.predictive_search_enabled
      or shop.permanent_domain == '2xu-jp.myshopify.com'
    -%}
      <script
        src='{{ 'predictive-search.js' | asset_url }}'
        defer='defer'
      ></script>
    {%- endif -%}

    {%- if template == 'customers/addresses' -%}
      <script
        src='{{ 'shopify_common.js' | shopify_asset_url }}'
        defer
      ></script>
      <script src='{{ 'customer_area.js' | shopify_asset_url }}' defer></script>
    {%- endif -%}

    
    
    
    {% if shop.permanent_domain == '2xu-nz.myshopify.com' %}
      
    {% endif %}
    {% if settings.ss_enable %}
      
    {% endif %}

    <div id='preezie-widget-div-id-popup'></div>
    <script type='text/javascript'>
      PREEZIE_GUIDE.render([
        {
          guideKey: 'EPO-ca00515d-67d8-4cfd-3cc5-08da540dcfdb',
          version: '1.0.0',
          renderTo: 'preezie-widget-div-id-popup',
        },
      ]);
    </script>

    
    
    
    
    
    {% if shop.permanent_domain == '2xu-us.myshopify.com' %}
      <div id='vsscript_139369_643127'></div>
      <script
        async
        type='text/javascript'
        src='https://app.viralsweep.com/vsa-lightbox-e036c1-139369.js?sid=139369_643127'
      ></script>
    {% endif %}

    
    {% if shop.permanent_domain == '2xu-us.myshopify.com' %}
      <script>
        (function () {
          var s = document.createElement('script');
          var h = document.querySelector('head') || document.body;
          s.src = 'https://acsbapp.com/apps/app/dist/js/app.js';
          s.async = true;
          s.onload = function () {
            acsbJS.init({
              statementLink: '',
              footerHtml: '',
              hideMobile: false,
              hideTrigger: false,
              disableBgProcess: false,
              language: 'en',
              position: 'right',
              leadColor: '#146ff8',
              triggerColor: '#146ff8',
              triggerRadius: '50%',
              triggerPositionX: 'right',
              triggerPositionY: 'bottom',
              triggerIcon: 'people',
              triggerSize: 'big',
              triggerOffsetX: 20,
              triggerOffsetY: 37,
              mobile: {
                triggerSize: 'medium',
                triggerPositionX: 'right',
                triggerPositionY: 'bottom',
                triggerOffsetX: 10,
                triggerOffsetY: 37,
                triggerRadius: '50%',
              },
            });
          };
          h.appendChild(s);
        })();
      </script>
    {% endif %}
    {% if shop.permanent_domain == '2xu-australia.myshopify.com' %}
      
    {% endif %}
  </body>

  <script>
    (function () {
      var REDIRECT_PATH = '/pages/preferences';

      var selector =
          '#create_customer, form[action$="/account"][method="post"]',
        $form = document.querySelectorAll(selector)[0];

      if ($form) {
        $redirect = document.createElement('input');
        $redirect.setAttribute('name', 'return_to');
        $redirect.setAttribute('type', 'hidden');
        $redirect.value = REDIRECT_PATH;
        $form.appendChild($redirect);
      }
    })();
  </script>
</html>
