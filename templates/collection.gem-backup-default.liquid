{% liquid
  # Relative to entrypointsDir
  render 'vite-tag' with 'plp.js'
%}
{% capture capsule_collections %}
  {
    "title": "{{ collection.metafields.custom.capsule_collections_title }}",
    "aspectRatio": "{{ collection.metafields.custom.capsule_collections_aspect_ratio }}",
    "collections": {% render 'json-capsule-collection', collection: collection %}
  }
{% endcapture %}
{% capture breadcrumbs %}
  {% render 'json-breadcrumb', collection: collection %}
{% endcapture %}
{% capture products %}
  {% render 'json-products', collection: collection %}
{% endcapture %}
{% capture sub_collections %}
  {% render 'json-sub-collections', collection: collection %}
{% endcapture %}
{% capture filters %}
  {% render 'json-collection-filters', collection: collection %}
{% endcapture %}
{% capture merch_tiles %}
  {% render 'json-merch-tiles', collection: collection %}
{% endcapture %}
{% capture seo_content %}
  {% render 'json-seo-content', collection: collection %}
{% endcapture %}
{% assign title = collection.metafields.collection_banner.title | default: collection.title | strip %}
{% assign description = collection.metafields.collection_banner.description | default: collection.description | strip %}
{% comment %}
  The tagalys-collection component is used to render the collection page with all necessary data.
  It includes the title, description, handle, breadcrumbs, capsule collections, sub-collections,
  filters, and products in JSON format.
{% endcomment %}
  <div class='tw-pt-2 md:tw-pt-4'>

    {% render 'html-breadcrumb', collection: collection %}

    <div class='tw-flex tw-flex-col tw-gap-2 tw-max-w-4xl tw-px-4 lg:tw-px-12'>
      <h1 class='tw-font-sweet-sans tw-uppercase tw-text-xl md:tw-text-5xl tw-leading-normal'>
        {{ title }}
      </h1>
      {% if description != blank %}
        <div class='!tw-font-euclid tw-text-base [&>*]:!tw-font-euclid'>
          {{ description }}
        </div>
      {% endif %}
    </div>
    <tagalys-collection
      handle='{{ collection.handle }}'
      capsule-collections='{{ capsule_collections | escape }}'
      sub-collections='{{ sub_collections | escape }}'
      filters='{{ filters | escape }}'
      products='{{ products | escape }}'
      merch-tiles='{{ merch_tiles | escape }}'
      seo-content='{{ seo_content | escape }}'
    >

    {% render 'html-sub-collections', collection: collection %}
    {% render 'html-capsule-collections', collection: collection %}
    <div class='tw-px-4 lg:tw-px-12 tw-py-4 tw-border-t tw-border-2xu-light-grey'>
      <div class='tw-py-4'>
        {% render 'html-filters' %}
      </div>
      <div class='tw-py-4'>
        {% render 'html-products', collection: collection %}
      </div>
    </div>
    {% render 'html-seo-content', collection: collection %}
  </tagalys-collection>
</div>
