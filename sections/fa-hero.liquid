<section data-section-id="{{ section.id }}">
  <div
    class="tw-aspect-[391/540] lg:tw-aspect-[1440/803] tw-relative tw-overflow-hidden"
    style="user-select: none; -webkit-user-select: none;"
  >
    {% assign slides = section.blocks %}
    {% if slides.size > 1 %}
      <div class="tw-absolute tw-z-30 tw-top-1/2 tw-transform -tw-translate-y-1/2 tw-flex tw-gap-6 tw-w-full tw-justify-between tw-px-4 lg:tw-px-12">
        <button
          type="button"
          class="tw-px-4 tw-py-2 tw-text-2xu-white"
          aria-label="Previous Slide"
          data-previous
        >
          {% render 'icon-left-chevron' %}
        </button>
        <button
          type="button"
          class="tw-px-4 tw-py-2 tw-text-2xu-white"
          aria-label="Next Slide"
          data-next
        >
          {% render 'icon-right-chevron' %}
        </button>
      </div>
    {% endif %}

    {% for block in slides %}
      {% if block.settings.content_position == 'centered' %}
        {% assign is_centered = true %}
      {% else %}
        {% assign is_centered = false %}
      {% endif %}
      <div
        data-block-id="{{ block.id }}"
        class="tw-absolute tw-inset-0 tw-transition-opacity tw-duration-700 tw-ease-in-out {% if forloop.first %}tw-opacity-100 tw-z-10{% else %}tw-opacity-0 tw-z-0{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="tw-absolute tw-z-20 tw-top-4 tw-left-4 lg:tw-top-6 lg:tw-left-10">
          <span class="tw-font-input-mono tw-text-2xu-white">
            {{ block.settings.breadcrumb_text }}
          </span>
        </div>
        {% if block.settings.image != blank and block.settings.mux_video == blank %}
          {% assign mobile_img = block.settings.mobile_image | default: block.settings.image %}
          {% if forloop.first %}
            <link
              rel="preload"
              as="image"
              media="(max-width: 767px)"
              imagesrcset="{{ mobile_img | image_url: width: 400 }} 400w, {{ mobile_img | image_url: width: 800 }} 800w"
              imagesizes="100vw"
              fetchpriority="high"
            />
            <link
              rel="preload"
              as="image"
              media="(min-width: 768px)"
              imagesrcset="{{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
              imagesizes="100vw"
              fetchpriority="high"
            />
          {% endif %}
          <picture>
            {{- '' -}}
            {%- comment -%}
              Mobile: cap at 800w (covers 2× retina on up to ~400px screens).
              Using a separate source prevents high-DPR mobile devices from
              pulling large desktop-sized images.
            {%- endcomment -%}
            <source
              media="(max-width: 767px)"
              srcset="
                {{ mobile_img | image_url: width: 400 }} 400w,
                {{ mobile_img | image_url: width: 800 }} 800w
              "
              sizes="100vw"
            />
            {%- comment -%}
              Desktop: includes a 2400w candidate for 2× retina screens
              (e.g. 1200px-wide viewport on a Retina MacBook).
            {%- endcomment -%}
            <source
              media="(min-width: 768px)"
              srcset="
                {{ block.settings.image | image_url: width: 1200 }} 1200w,
                {{ block.settings.image | image_url: width: 1600 }} 1600w,
                {{ block.settings.image | image_url: width: 2400 }} 2400w
              "
              sizes="100vw"
            />
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.heading }}"
              class="tw-absolute tw-inset-0 tw-w-full tw-h-full tw-object-cover tw-object-center"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              {% if forloop.first %}fetchpriority="high"{% endif %}
            />
          </picture>
        {% elsif block.settings.mux_video != blank %}
          <picture>
            <source
              media="(orientation: portrait)"
              srcset="https://image.mux.com/{{ block.settings.mux_video }}/thumbnail.jpg?width=400 400w, https://image.mux.com/{{ block.settings.mux_video }}/thumbnail.jpg?width=800 800w, https://image.mux.com/{{ block.settings.mux_video }}/thumbnail.jpg?width=1200 1200w, https://image.mux.com/{{ block.settings.mux_video }}/thumbnail.jpg?width=1600 1600w"
              sizes="100vw"
            />
            <img src="https://image.mux.com/{{ block.settings.mux_video }}/thumbnail.jpg?width=1000"
              alt="{{ block.settings.heading }}"
              class="tw-absolute tw-inset-0 tw-w-full tw-h-full tw-object-cover tw-object-center"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              {% if forloop.first %}fetchpriority="high"{% endif %}
            />
          </picture>
        {% else %}
          <div class="tw-absolute tw-inset-0 tw-bg-gray-200 show-empty"></div>
        {% endif %}

        {% if block.settings.mux_video != blank %}
          <div class="tw-absolute tw-inset-0 tw-overflow-hidden">
            <div data-desktop-video class="tw-hidden">
              <mux-video
                class="tw-absolute tw-inset-0 tw-w-full tw-h-full tw-object-cover tw-object-center"
                loop
                muted
                loading="viewport"
                preload="metadata"
                data-playback-id="{{ block.settings.mux_video }}"
              />
            </div>
            {% if block.settings.mux_mobile_video != blank %}
              <div data-mobile-video class="tw-hidden">
                <mux-video
                  class="tw-absolute tw-inset-0 tw-w-full tw-h-full tw-object-cover tw-object-center"
                  loop
                  muted
                  loading="viewport"
                  preload="metadata"
                  data-playback-id="{{ block.settings.mux_mobile_video }}"
                />
              </div>
            {% endif %}
          </div>
        {% endif %}
        <div class="tw-absolute tw-inset-0 tw-z-20 tw-flex {% if is_centered %}tw-items-center tw-justify-center{% else %}tw-items-end tw-justify-start{% endif %}">
          <div class="tw-px-4 lg:tw-px-12 tw-w-full">
            <div class="tw-flex {% if is_centered %}tw-flex-col tw-items-center tw-text-center{% else %}tw-flex-col md:tw-flex-row md:tw-justify-between{% endif %} tw-pb-12">
              <div class="show-empty tw-flex tw-flex-col tw-text-2xu-white {% if is_centered %}  {% else %}lg:tw-mb-0{% endif %} tw-mb-6">
                {% if block.settings.subheading != blank %}
                  <p class="tw-text-lg md:tw-text-xl tw-text-2xu-white tw-font-sweet-sans tw-text-shadow-flux tw-mb-4 md:tw-mb-5">
                    {{ block.settings.subheading }}
                  </p>
                {% endif %}
                {% if block.settings.heading != blank %}
                  <h2 class="tw-text-3xl md:tw-text-7xl tw-leading-tight tw-font-sweet-sans">
                    {{ block.settings.heading }}
                  </h2>
                {% endif %}
              </div>
              <div class="tw-flex tw-gap-2 tw-items-end md:tw-justify-end tw-shrink">
                {% if block.settings.button_1_text and block.settings.button_1_link %}
                  <a href="{{ block.settings.button_1_link }}" class="tw-bg-2xu-white tw-text-2xu-black tw-px-5 md:tw-px-10 tw-py-2 md:tw-py-3 tw-rounded md:tw-font-medium tw-text-xs md:tw-text-sm tw-font-euclid tw-whitespace-nowrap tw-transition-colors hover:tw-bg-2xu-black hover:tw-text-2xu-white">
                    {{ block.settings.button_1_text }}
                  </a>
                {% endif %}
                {% if block.settings.button_2_text and block.settings.button_2_link %}
                  <a href="{{ block.settings.button_2_link }}" class="tw-bg-2xu-white/50 tw-text-2xu-white tw-px-5 md:tw-px-10 tw-py-2 md:tw-py-3 tw-rounded md:tw-font-medium tw-text-xs md:tw-text-sm tw-font-euclid tw-whitespace-nowrap tw-transition-colors hover:tw-bg-2xu-black hover:tw-text-2xu-white">
                    {{ block.settings.button_2_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% assign has_mux = false %}
{% for block in section.blocks %}
  {% if block.settings.mux_video != blank or block.settings.mux_mobile_video != blank %}
    {% assign has_mux = true %}
    {% break %}
  {% endif %}
{% endfor %}
{% if has_mux %}
  <script defer src="{{ 'mux-video.min.js' | asset_url }}"></script>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    let autoSlideInterval;
    let active = 0;
    let touchStartX = null;
    let touchEndX = null;
    let mouseDownX  = null;
    let mouseUpX = null;
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    const slides = section.querySelectorAll('[data-block-id]');
    const prevButton = section.querySelector('[data-previous]');
    const nextButton = section.querySelector('[data-next]');

    // Handle playing of videos that are on the first active slide
    const videoWrapper = slides[0].querySelector('[data-desktop-video]');
    if (videoWrapper) {
      const video = videoWrapper.querySelector('mux-video');
      video.addEventListener('canplay', function() {
        videoWrapper.classList.remove('tw-hidden');
        videoWrapper.classList.add('tw-hidden', 'lg:tw-block');
        video.play();
      });
      if (window.innerWidth >= 1024) {
        video.setAttribute('playback-id', video.dataset.playbackId);
      }
    }
    const mobileVideoWrapper = slides[0].querySelector('[data-mobile-video]');
    if (mobileVideoWrapper) {
      const mobileVideo = mobileVideoWrapper.querySelector('mux-video');
      mobileVideo.addEventListener('canplay', function() {
        mobileVideoWrapper.classList.remove('tw-hidden');
        mobileVideoWrapper.classList.add('tw-block', 'lg:tw-hidden');
        mobileVideo.play();
      });
      if (window.innerWidth < 1024) {
        mobileVideo.setAttribute('playback-id', mobileVideo.dataset.playbackId);
      }
    }



    function resetAutoSlide() {
      if ({{ section.settings.slide_duration }} > 0 && slides.length > 1 && !window.Shopify?.designMode) {
        clearInterval(autoSlideInterval);
        autoSlideInterval = setInterval(function() {
          if (nextButton) {
            setActive(active === slides.length - 1 ? 0 : active + 1);
          }
        }, {{ section.settings.slide_duration | times: 1000 }});
      }
    }

    function setActive(idx) {
      active = idx;
      slides.forEach(function(slide, i) {
        const videoWrapper = slide.querySelector('[data-desktop-video]');
        const mobileVideoWrapper = slide.querySelector('[data-mobile-video]');
        if (i === active) {
          slide.classList.add('tw-opacity-100', 'tw-z-10');
          slide.classList.remove('tw-opacity-0', 'tw-z-0');
          if (videoWrapper) {
            const video = videoWrapper.querySelector('mux-video');
            if (video) {
              video.play();
              if (window.innerWidth >= 1024 && !video.getAttribute('playback-id')) {
                video.setAttribute('playback-id', video.dataset.playbackId);
              }
            }
          }
          if (mobileVideoWrapper) {
            const mobileVideo = mobileVideoWrapper.querySelector('mux-video');
            if (mobileVideo) {
              mobileVideo.play();
              if (window.innerWidth < 1024 && !mobileVideo.getAttribute('playback-id')) {
                mobileVideo.setAttribute('playback-id', mobileVideo.dataset.playbackId);
              }
            }
          }
        } else {
          slide.classList.add('tw-opacity-0', 'tw-z-0');
          slide.classList.remove('tw-opacity-100', 'tw-z-10');
          if (videoWrapper) {
            const video = videoWrapper.querySelector('mux-video');
            if (video) {
              video.pause();
              video.currentTime = 0;
            }
          }
          if (mobileVideoWrapper) {
            const mobileVideo = mobileVideoWrapper.querySelector('mux-video');
            if (mobileVideo) {
              mobileVideo.pause();
              mobileVideo.currentTime = 0;
            }
          }
        }
      });
    }

    function handleBlockSelect(event) {
      const blockId = event.target.closest('[data-block-id]')?.getAttribute('data-block-id');
      if (blockId) {
        const index = Array.from(slides).findIndex(slide => slide.getAttribute('data-block-id') === blockId);
        if (index !== -1) {
          setActive(index);
        }
      }
    }

    function handleTouchStart(e) {
      touchStartX = e.touches[0].clientX;
      touchEndX = null;
    }

    function handleTouchMove(e) {
      touchEndX = e.touches[0].clientX;
    }

    function handleTouchEnd(e) {
      if (touchStartX === null || touchEndX === null) return;
      const touchDiff = touchStartX - touchEndX;
      if (Math.abs(touchDiff) > 50) {
        if (touchDiff > 0) {
          setActive(active === slides.length - 1 ? 0 : active + 1);
        } else {
          setActive(active === 0 ? slides.length - 1 : active - 1);
        }
        resetAutoSlide();
      }
      touchStartX = null;
      touchEndX = null;
    }

    function handleMouseDown(e) {
      mouseDownX = e.clientX;
      mouseUpX = null;
    }

    function handleMouseMove(e) {
      if (mouseDownX !== null) {
        mouseUpX = e.clientX;
      }
    }

    function handleMouseUp() {
      if (mouseDownX !== null && mouseUpX !== null) {
        const distance = mouseDownX - mouseUpX;
        if (Math.abs(distance) > 50) {
          if (distance > 0) {
            setActive(active === slides.length - 1 ? 0 : active + 1);
          } else {
            setActive(active === 0 ? slides.length - 1 : active - 1);
          }
          resetAutoSlide();
        }
      }
      mouseDownX = null;
      mouseUpX = null;
    }

    resetAutoSlide();

    if (prevButton) {
      prevButton.addEventListener('click', function(e) {
        if (e) e.preventDefault();
        setActive(active === 0 ? slides.length - 1 : active - 1);
        resetAutoSlide();
      });
    }
    if (nextButton) {
      nextButton.addEventListener('click', function(e) {
        if (e) e.preventDefault();
        setActive(active === slides.length - 1 ? 0 : active + 1);
        resetAutoSlide();
      });
    }
    document.addEventListener('shopify:block:select', handleBlockSelect);

    section.addEventListener('touchstart', handleTouchStart);
    section.addEventListener('touchmove', handleTouchMove);
    section.addEventListener('touchend', handleTouchEnd);

    section.addEventListener('mousedown', handleMouseDown);
    section.addEventListener('mousemove', handleMouseMove);
    section.addEventListener('mouseup', handleMouseUp);
    section.addEventListener('mouseleave', handleMouseUp);
  });
</script>

{% schema %}
{
  "name": "F.A. Hero",
  "settings": [
    {
      "type": "number",
      "id": "slide_duration",
      "label": "Slide Duration (seconds)",
      "default": 5,
      "info": "Set to 0 to disable auto-slide"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "breadcrumb_text",
          "label": "Breadcrumb Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Add an image even when using video for better mobile performance."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image",
          "info": "Optional mobile-specific image, falls back to desktop image if not set"
        },
        {
          "type": "text",
          "id": "mux_video",
          "label": "Mux Video",
          "info": "Upload your video to Mux and add the playback ID."
        },
        {
          "type": "text",
          "id": "mux_mobile_video",
          "label": "Mux Mobile Video",
          "info": "Upload your mobile video to Mux and add the playback ID here."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "header",
          "content": "Button 1"
        },
        {
          "type": "text",
          "id": "button_1_text",
          "label": "Button 1 Text"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button 1 Link"
        },
        {
          "type": "header",
          "content": "Button 2"
        },
        {
          "type": "text",
          "id": "button_2_text",
          "label": "Button 2 Text"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button 2 Link"
        },
        {
          "type": "header",
          "content": "Styling"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content Position",
          "options": [
            {
              "value": "centered",
              "label": "Centered"
            },
            {
              "value": "left",
              "label": "Bottom Left"
            }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Homepage Section",
      "name": "F.A. Hero"
    }
  ]
}
{% endschema %}
