{{ 'basic-form.css' | asset_url | stylesheet_tag }}
{{ 'account.css' | asset_url | stylesheet_tag }}
{{ 'accounts.css' | asset_url | stylesheet_tag }}

{% if customer %}
  {% render 'account-mobile-top',
    account_header_title: 'Password',
    margin_bottom: 'banner-password'
  %}

  <div class='Container Container--narrow Container--account-dashboard page-password-reset'>
    {% render 'account-navigation' %}
    <div
      class='PageLayout PageLayout--breakLap'
      {% unless customer %}
        style='flex: none; width: 100%'
      {% endunless %}
    >
      <div
        class='container-password-page'
        {% unless customer %}
          style='margin: auto;'
        {% endunless %}
      >
        {%- form 'recover_customer_password',
          name: 'recover',
          class: 'Form Form--spacingTight',
          id: 'recover_customer_password',
          style: recover_default_visibility
        -%}
          <header class='Form__Header'>
            <h1 class='account-title'>
              {{ 'customer.reset_password.password' | t }}
            </h1>
            {%- unless form.posted_successfully? -%}
              <p class='account-password-parra'>
                {{ 'customer.reset_password.reset_password_description' | t }}
              </p>
            {%- endunless -%}
          </header>
          {%- if form.errors -%}
            <p class='Form__Alert Alert Alert--error'>
              {{- form.errors.messages.form -}}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class='Form__Alert Alert Alert--success'>
              {{- 'customer.recover_password.success' | t -}}
            </p>
          {%- endif -%}
          <div class='Form__Item reset-password-btn'>
            <label class='reset-password-label'>
              {{- 'customer.recover_password.email' | t -}}
            </label>
            <input
              type='email'
              class='Form__Input'
              name='email'
              required='required'
              aria-label='{{ 'customer.recover_password.email' | t }}'
              autofocus
            >
          </div>
          <button type='submit' class='password-reset-button'>
            {{ 'customer.reset_password.submit_button' | t }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
{% endif %}
