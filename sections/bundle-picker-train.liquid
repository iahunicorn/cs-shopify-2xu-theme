<script>
(function () {
  document.querySelectorAll('.bp-gender-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.bp-gender-btn').forEach(function(b) { b.classList.remove('is-active'); });
      document.querySelectorAll('.bp-panel').forEach(function(p) { p.classList.remove('is-active'); });
      btn.classList.add('is-active');
      document.getElementById('bp-panel-' + btn.dataset.gender).classList.add('is-active');
    });
  });

  function initPicker(gender, tabOrder) {
    var panel      = document.getElementById('bp-panel-' + gender);
    var previewImg = document.getElementById('bp-preview-img-' + gender);
    var counter    = document.getElementById('bp-counter-' + gender);
    var nameEl     = document.getElementById('bp-name-' + gender);
    var colourEl   = document.getElementById('bp-colour-' + gender);
    var linkEl     = document.getElementById('bp-link-' + gender);
    var priceEl    = document.getElementById('bp-price-' + gender);
    var sizesEl    = document.getElementById('bp-sizes-' + gender);
    var stockEl    = document.getElementById('bp-stock-' + gender);
    var selectBtn  = document.getElementById('bp-select-' + gender);
    var atcBtn     = document.getElementById('bp-atc-' + gender);
    var atcError   = document.getElementById('bp-atc-error-' + gender);
    var selectedVariantId = null;
    var selections = {};
    tabOrder.forEach(function(t) { selections[t] = null; });

    function currentTab() { var active = panel.querySelector('.bp-tab.is-active'); return active ? active.dataset.tab : tabOrder[0]; }
    function checkAllSelected() {
      var allDone = tabOrder.every(function(t) { return selections[t] && selections[t].confirmed; });
      if (allDone) { atcBtn.classList.add('is-visible'); } else { atcBtn.classList.remove('is-visible'); atcError.classList.remove('is-visible'); }
    }
    function markSummary(tab, confirmed) {
      var row = document.getElementById('bp-summary-' + tab);
      var check = document.getElementById('bp-summary-' + tab + '-check');
      if (!row) return;
      if (confirmed) { row.classList.remove('is-pending'); if (check) check.textContent = '\u2713'; }
      else { row.classList.add('is-pending'); if (check) check.textContent = ''; }
    }
    function resetSelect() { selectBtn.textContent = 'SELECT'; selectBtn.classList.remove('is-confirmed'); }
    function showSummaryImage(tab, src, title) {
      var placeholder = document.getElementById('bp-summary-' + tab + '-placeholder');
      var img = document.getElementById('bp-summary-' + tab + '-img');
      if (placeholder) placeholder.style.display = 'none';
      if (img) { img.src = src; img.alt = title; img.style.display = 'block'; }
    }
    function updateColour(data) {
      if (!colourEl || !data.options) return;
      var opt = data.options.find(function(o) { return o.name.toLowerCase() === 'color' || o.name.toLowerCase() === 'colour'; });
      colourEl.textContent = opt ? opt.values[0] : (data.options[0] ? data.options[0].values[0] : '');
    }

    panel.querySelectorAll('.bp-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        panel.querySelectorAll('.bp-tab').forEach(function(t) { t.classList.remove('is-active'); });
        panel.querySelectorAll('.bp-grid').forEach(function(g) { g.classList.add('is-hidden'); });
        tab.classList.add('is-active');
        document.getElementById('bp-grid-' + tab.dataset.tab).classList.remove('is-hidden');
        var sel = selections[tab.dataset.tab];
        if (sel && sel.confirmed) { selectBtn.textContent = 'SELECTED \u2713'; selectBtn.classList.add('is-confirmed'); } else { resetSelect(); }
      });
    });

    panel.addEventListener('click', function(e) {
      var thumb = e.target.closest('.bp-thumb');
      if (!thumb) return;
      thumb.closest('.bp-grid').querySelectorAll('.bp-thumb').forEach(function(t) { t.classList.remove('is-selected'); });
      thumb.classList.add('is-selected');
      previewImg.src = thumb.dataset.image;
      nameEl.textContent = thumb.dataset.title;
      priceEl.textContent = thumb.dataset.price + ' AUD';
      linkEl.href = '/products/' + thumb.dataset.handle;
      counter.textContent = '1 / ' + thumb.dataset.count;
      stockEl.textContent = thumb.dataset.available === 'true' ? 'In Stock' : 'Out of Stock';
      var tab = currentTab();
      var summaryName = document.getElementById('bp-summary-' + tab + '-name');
      if (summaryName) summaryName.textContent = thumb.dataset.title;
      showSummaryImage(tab, thumb.dataset.thumb, thumb.dataset.title);
      if (selections[tab] && selections[tab].confirmed) { selections[tab].confirmed = false; markSummary(tab, false); checkAllSelected(); }
      resetSelect();
      fetch('/products/' + thumb.dataset.handle + '.js')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          sizesEl.innerHTML = data.variants.map(function(v, i) {
            var label = v.title.split(' / ').pop();
            return '<button class="bp-size' + (i === 0 ? ' is-active' : '') + (!v.available ? ' is-sold-out' : '') + '" data-variant-id="' + v.id + '" data-label="' + label + '"' + (!v.available ? ' disabled' : '') + '>' + label + '</button>';
          }).join('');
          var first = data.variants.find(function(v) { return v.available; }) || data.variants[0];
          selectedVariantId = first ? String(first.id) : null;
          updateColour(data);
        })
        .catch(function(err) { console.error('Bundle picker:', err); });
    });

    sizesEl.addEventListener('click', function(e) {
      var btn = e.target.closest('.bp-size');
      if (!btn || btn.disabled) return;
      sizesEl.querySelectorAll('.bp-size').forEach(function(b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      selectedVariantId = btn.dataset.variantId;
      var tab = currentTab();
      if (selections[tab] && selections[tab].confirmed) { selections[tab].confirmed = false; markSummary(tab, false); resetSelect(); checkAllSelected(); }
    });

    selectBtn.addEventListener('click', function() {
      if (!selectedVariantId) { alert('Please choose a size first.'); return; }
      var tab = currentTab();
      var activeSize = sizesEl.querySelector('.bp-size.is-active');
      var sizeLabel = activeSize ? activeSize.textContent.trim() : '';
      var tabLabel = panel.querySelector('.bp-tab.is-active').textContent.trim();
      selections[tab] = { variantId: selectedVariantId, size: sizeLabel, confirmed: true };
      var summarySize = document.getElementById('bp-summary-' + tab + '-size');
      if (summarySize) summarySize.textContent = tabLabel + ' \u2014 ' + sizeLabel;
      markSummary(tab, true);
      selectBtn.textContent = 'SELECTED \u2713';
      selectBtn.classList.add('is-confirmed');
      checkAllSelected();
      var currentIndex = tabOrder.indexOf(tab);
      var nextIndex = currentIndex + 1;
      while (nextIndex < tabOrder.length && selections[tabOrder[nextIndex]] && selections[tabOrder[nextIndex]].confirmed) { nextIndex++; }
      if (nextIndex < tabOrder.length) {
        setTimeout(function() {
          var nextTabBtn = panel.querySelector('.bp-tab[data-tab="' + tabOrder[nextIndex] + '"]');
          if (nextTabBtn) nextTabBtn.click();
          var nextGrid = document.getElementById('bp-grid-' + tabOrder[nextIndex]);
          if (nextGrid) { var firstThumb = nextGrid.querySelector('.bp-thumb'); if (firstThumb) firstThumb.click(); }
        }, 400);
      }
    });

    atcBtn.addEventListener('click', function() {
      var allConfirmed = tabOrder.every(function(t) { return selections[t] && selections[t].confirmed; });
      if (!allConfirmed) return;
      atcBtn.disabled = true; atcBtn.textContent = 'ADDING...'; atcError.classList.remove('is-visible');
      var items = tabOrder.map(function(t) { return { id: Number(selections[t].variantId), quantity: 1 }; });
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: items }) })
        .then(function(r) { if (!r.ok) throw new Error('Cart error'); return r.json(); })
        .then(function() { atcBtn.textContent = 'ADDED \u2713'; setTimeout(function() { window.location.href = '/cart'; }, 600); })
        .catch(function(err) { console.error('ATC error:', err); atcBtn.disabled = false; atcBtn.textContent = 'ADD BUNDLE TO CART'; atcError.classList.add('is-visible'); });
    });

    var firstSize = sizesEl.querySelector('.bp-size:not([disabled])');
    if (firstSize) selectedVariantId = firstSize.dataset.variantId;
  }

  initPicker('man',   ['man-tab1', 'man-tab2', 'man-tab3']);
  initPicker('woman', ['woman-tab1', 'woman-tab2', 'woman-tab3']);
})();
</script>

{% schema %}
