<style>
  .bp-hero { padding: 40px 24px 36px 24px; text-align: left; border-bottom: 1px solid #e0e0e0; }
  .bp-hero__eyebrow { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #888; margin-bottom: 8px; }
  .bp-hero__title { font-family: 'Bebas Neue', sans-serif; font-size: 42px; font-weight: 400; color: #111; letter-spacing: 0.02em; text-transform: uppercase; margin-bottom: 12px; line-height: 1; }
  .bp-hero__copy { font-size: 13px; color: #555; max-width: 480px; margin: 0 0 16px 0; line-height: 1.7; }
  .bp-hero__badge { display: inline-block; background: #111; color: #fff; font-size: 10px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; padding: 8px 18px; border-radius: 2px; }
  @media (max-width: 700px) { .bp-hero { padding: 28px 16px; } .bp-hero__title { font-size: 32px; } }

  .bp-header { padding: 20px 24px; border-bottom: 1px solid #e0e0e0; display: flex; align-items: center; gap: 16px; font-size: 15px; color: #111; }
  .bp-header__title { font-weight: 500; margin-right: 4px; }
  .bp-gender-btn { font-size: 15px; font-family: inherit; border: none; background: none; cursor: pointer; color: #bbb; padding: 0; text-decoration: underline; }
  .bp-gender-btn.is-active { color: #111; font-weight: 500; }

  .bp-panel { display: none; }
  .bp-panel.is-active { display: block; }

  .bp-wrapper { display: grid; grid-template-columns: 380px 1fr 320px; align-items: start; border-top: 1px solid #e0e0e0; }

  .bp-left { border-right: 1px solid #e0e0e0; padding: 20px 16px; overflow-y: auto; max-height: 600px; position: sticky; top: 0; }
  .bp-tabs { display: flex; gap: 24px; border-bottom: 1px solid #e0e0e0; margin-bottom: 16px; }
  .bp-tab { font-size: 13px; font-family: inherit; padding-bottom: 12px; border: none; background: none; border-bottom: 2px solid transparent; cursor: pointer; color: #999; margin-bottom: -1px; }
  .bp-tab.is-active { color: #111; border-bottom-color: #111; font-weight: 500; }
  .bp-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .bp-grid.is-hidden { display: none; }
  .bp-thumb { aspect-ratio: 1 / 1; border-radius: 3px; overflow: hidden; cursor: pointer; border: 2px solid transparent; background: #f5f5f5; transition: border-color 0.12s; }
  .bp-thumb:hover { border-color: #888; }
  .bp-thumb.is-selected { border-color: #111; }
  .bp-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .bp-preview { background: #ebebeb; position: relative; }
  .bp-preview-img { width: 100%; height: auto; max-height: 600px; object-fit: contain; display: block; }
  .bp-counter { position: absolute; bottom: 14px; left: 18px; font-size: 12px; color: #555; }

  .bp-info { padding: 28px 24px; border-left: 1px solid #e0e0e0; display: flex; flex-direction: column; gap: 16px; overflow-y: auto; max-height: 600px; position: sticky; top: 0; }
  .bp-info__name { font-size: 14px; font-weight: 400; color: #111; line-height: 1.4; }
  .bp-info__colour { font-size: 12px; color: #888; }
  .bp-info__link { font-size: 13px; color: #111; text-decoration: underline; }
  .bp-divider { border: none; border-top: 1px solid #e0e0e0; margin: 0; }
  .bp-info__price { font-size: 14px; color: #111; }
  .bp-info__label { font-size: 12px; color: #888; margin-bottom: 8px; }
  .bp-sizes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .bp-size { height: 42px; border: 1px solid #d0d0d0; border-radius: 3px; font-size: 12px; font-family: inherit; background: #fff; cursor: pointer; color: #111; transition: background 0.1s; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 0 6px; }
  .bp-size:hover:not(.is-sold-out) { background: #f5f5f5; }
  .bp-size.is-active { background: #111; color: #fff; border-color: #111; }
  .bp-size.is-sold-out { color: #ccc; cursor: not-allowed; text-decoration: line-through; }
  .bp-info__stock { font-size: 12px; color: #888; }
  .bp-select-btn { width: 100%; height: 52px; border: 1px solid #d0d0d0; border-radius: 3px; font-size: 11px; font-family: inherit; font-weight: 500; letter-spacing: 0.12em; background: #fff; cursor: pointer; color: #111; transition: background 0.1s, color 0.1s; }
  .bp-select-btn:hover { background: #f5f5f5; }
  .bp-select-btn.is-confirmed { background: #111; color: #fff; border-color: #111; }

  .bp-summary { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
  .bp-summary__label { font-size: 11px; color: #bbb; font-style: italic; margin-bottom: 2px; }
  .bp-summary-item { display: flex; align-items: center; gap: 10px; padding: 8px; border: 1px solid #e0e0e0; border-radius: 3px; background: #fafafa; transition: opacity 0.2s; }
  .bp-summary-item.is-pending { opacity: 0.4; }
  .bp-summary-item__img-placeholder { width: 48px; height: 48px; border-radius: 2px; background: #ebebeb; flex-shrink: 0; }
  .bp-summary-item__img { width: 48px; height: 48px; object-fit: cover; border-radius: 2px; flex-shrink: 0; display: none; }
  .bp-summary-item__text { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .bp-summary-item__name { font-size: 12px; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bp-summary-item__size { font-size: 11px; color: #888; }
  .bp-summary-item__check { font-size: 14px; color: #111; flex-shrink: 0; }

  .bp-atc-btn { width: 100%; height: 54px; border: none; border-radius: 3px; font-size: 12px; font-family: inherit; font-weight: 500; letter-spacing: 0.12em; background: #111; cursor: pointer; color: #fff; transition: background 0.15s; display: none; }
  .bp-atc-btn.is-visible { display: block; }
  .bp-atc-btn:hover { background: #333; }
  .bp-atc-btn:disabled { background: #999; cursor: not-allowed; }
  .bp-atc-error { font-size: 11px; color: #c00; display: none; }
  .bp-atc-error.is-visible { display: block; }

  @media (max-width: 1100px) {
    .bp-wrapper { grid-template-columns: 1fr 1fr; }
    .bp-preview { grid-column: 1 / 3; }
    .bp-left { max-height: none; position: static; }
    .bp-info { max-height: none; position: static; }
    .bp-preview-img { max-height: none; }
  }
  @media (max-width: 700px) {
    .bp-wrapper { grid-template-columns: 1fr; }
    .bp-preview { grid-column: 1; }
    .bp-left { padding: 12px; }
    .bp-grid { display: flex; flex-direction: row; overflow-x: auto; gap: 6px; padding-bottom: 8px; scrollbar-width: none; -ms-overflow-style: none; }
    .bp-grid::-webkit-scrollbar { display: none; }
    .bp-thumb { flex: 0 0 72px; width: 72px; height: 72px; aspect-ratio: unset; }
  }
</style>

<div class="bp-hero">
  <p class="bp-hero__eyebrow">2XU Train Kit</p>
  <h2 class="bp-hero__title">Build Your Kit and Save 20%.</h2>
  <p class="bp-hero__copy">Push harder, recover smarter and show up ready. Select your top, shorts and socks to build your complete 2XU Train kit — mix and match across styles and colours to make it yours. Enjoy 20% off when you complete the bundle.</p>
  <span class="bp-hero__badge">20% Off When You Bundle</span>
</div>

{%- assign man_tab1_col   = collections['mens-train-bundle-top'] -%}
{%- assign man_tab2_col   = collections['mens-train-bundle-shorts'] -%}
{%- assign man_tab3_col   = collections['3-for-80-vectr-socks-29-99-styles-only'] -%}
{%- assign woman_tab1_col = collections['womens-train-bundle-top'] -%}
{%- assign woman_tab2_col = collections['womens-train-bundle-shorts'] -%}
{%- assign woman_tab3_col = collections['3-for-80-vectr-socks-29-99-styles-only'] -%}
{%- assign man_first1     = man_tab1_col.products.first -%}
{%- assign woman_first1   = woman_tab1_col.products.first -%}

<div class="bp-header">
  <span class="bp-header__title">{{ section.settings.bundle_title | default: 'Train Bundle' }}:</span>
  <button class="bp-gender-btn is-active" data-gender="man">{{ section.settings.man_label | default: 'Mens' }}</button>
  <button class="bp-gender-btn" data-gender="woman">{{ section.settings.woman_label | default: 'Womens' }}</button>
</div>

<div class="bp-panel is-active" id="bp-panel-man">
  <div class="bp-wrapper">
    <div class="bp-left">
      <div class="bp-tabs">
        <button class="bp-tab is-active" data-tab="man-tab1">{{ section.settings.man_tab1_label | default: 'Top' }}</button>
        <button class="bp-tab" data-tab="man-tab2">{{ section.settings.man_tab2_label | default: 'Shorts' }}</button>
        <button class="bp-tab" data-tab="man-tab3">{{ section.settings.man_tab3_label | default: 'Socks' }}</button>
      </div>
      <div class="bp-grid" id="bp-grid-man-tab1">
        {%- for product in man_tab1_col.products -%}
          <div class="bp-thumb" data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-price="{{ product.price | money }}" data-image="{{ product.featured_image | image_url: width: 900 }}" data-thumb="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}" data-count="{{ product.images.size }}" data-available="{{ product.available }}">
            <img src="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy" width="400" height="400">
          </div>
        {%- endfor -%}
      </div>
      <div class="bp-grid is-hidden" id="bp-grid-man-tab2">
        {%- for product in man_tab2_col.products -%}
          <div class="bp-thumb" data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-price="{{ product.price | money }}" data-image="{{ product.featured_image | image_url: width: 900 }}" data-thumb="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}" data-count="{{ product.images.size }}" data-available="{{ product.available }}">
            <img src="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy" width="400" height="400">
          </div>
        {%- endfor -%}
      </div>
      <div class="bp-grid is-hidden" id="bp-grid-man-tab3">
        {%- for product in man_tab3_col.products -%}
          <div class="bp-thumb" data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-price="{{ product.price | money }}" data-image="{{ product.featured_image | image_url: width: 900 }}" data-thumb="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}" data-count="{{ product.images.size }}" data-available="{{ product.available }}">
            <img src="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy" width="400" height="400">
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="bp-preview">
      <img class="bp-preview-img" id="bp-preview-img-man" src="{{ man_first1.featured_image | image_url: width: 900 }}" alt="{{ man_first1.title | escape }}">
      <span class="bp-counter" id="bp-counter-man">1 / {{ man_first1.images.size }}</span>
    </div>
    <div class="bp-info">
      <p class="bp-info__name" id="bp-name-man">{{ man_first1.title }}</p>
      <p class="bp-info__colour" id="bp-colour-man"></p>
      <a class="bp-info__link" id="bp-link-man" href="/products/{{ man_first1.handle }}">View product</a>
      <hr class="bp-divider">
      <p class="bp-info__price" id="bp-price-man">{{ man_first1.price | money }} AUD</p>
      <div>
        <p class="bp-info__label">Size</p>
        <div class="bp-sizes" id="bp-sizes-man">
          {%- for variant in man_first1.variants -%}
            <button class="bp-size{% if forloop.first %} is-active{% endif %}{% unless variant.available %} is-sold-out{% endunless %}" data-variant-id="{{ variant.id }}" data-label="{{ variant.title | split: ' / ' | last }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | split: ' / ' | last }}</button>
          {%- endfor -%}
        </div>
      </div>
      <p class="bp-info__stock" id="bp-stock-man">{%- if man_first1.available -%}In Stock{%- else -%}Out of Stock{%- endif -%}</p>
      <button class="bp-select-btn" id="bp-select-man">SELECT</button>
      <div class="bp-summary">
        <p class="bp-summary__label">Bundle and Save 20%</p>
        <div class="bp-summary-item is-pending" id="bp-summary-man-tab1">
          <div class="bp-summary-item__img-placeholder" id="bp-summary-man-tab1-placeholder"></div>
          <img class="bp-summary-item__img" id="bp-summary-man-tab1-img" src="" alt="">
          <div class="bp-summary-item__text"><span class="bp-summary-item__name" id="bp-summary-man-tab1-name">{{ section.settings.man_tab1_label | default: 'Top' }}</span><span class="bp-summary-item__size" id="bp-summary-man-tab1-size">Not yet selected</span></div>
          <span class="bp-summary-item__check" id="bp-summary-man-tab1-check"></span>
        </div>
        <div class="bp-summary-item is-pending" id="bp-summary-man-tab2">
          <div class="bp-summary-item__img-placeholder" id="bp-summary-man-tab2-placeholder"></div>
          <img class="bp-summary-item__img" id="bp-summary-man-tab2-img" src="" alt="">
          <div class="bp-summary-item__text"><span class="bp-summary-item__name" id="bp-summary-man-tab2-name">{{ section.settings.man_tab2_label | default: 'Shorts' }}</span><span class="bp-summary-item__size" id="bp-summary-man-tab2-size">Not yet selected</span></div>
          <span class="bp-summary-item__check" id="bp-summary-man-tab2-check"></span>
        </div>
        <div class="bp-summary-item is-pending" id="bp-summary-man-tab3">
          <div class="bp-summary-item__img-placeholder" id="bp-summary-man-tab3-placeholder"></div>
          <img class="bp-summary-item__img" id="bp-summary-man-tab3-img" src="" alt="">
          <div class="bp-summary-item__text"><span class="bp-summary-item__name" id="bp-summary-man-tab3-name">{{ section.settings.man_tab3_label | default: 'Socks' }}</span><span class="bp-summary-item__size" id="bp-summary-man-tab3-size">Not yet selected</span></div>
          <span class="bp-summary-item__check" id="bp-summary-man-tab3-check"></span>
        </div>
      </div>
      <button class="bp-atc-btn" id="bp-atc-man">ADD BUNDLE TO CART</button>
      <p class="bp-atc-error" id="bp-atc-error-man">Something went wrong. Please try again.</p>
    </div>
  </div>
</div>

