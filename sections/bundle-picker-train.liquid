  "name": "Bundle Picker — Train",
  "settings": [
    { "type": "text", "id": "bundle_title", "label": "Bundle title", "default": "Train Bundle" },
    { "type": "text", "id": "man_label", "label": "Mens toggle label", "default": "Mens" },
    { "type": "text", "id": "woman_label", "label": "Womens toggle label", "default": "Womens" },
    { "type": "header", "content": "Mens — Tab 1" },
    { "type": "text", "id": "man_tab1_label", "label": "Tab label", "default": "Top" },
    { "type": "header", "content": "Mens — Tab 2" },
    { "type": "text", "id": "man_tab2_label", "label": "Tab label", "default": "Shorts" },
    { "type": "header", "content": "Mens — Tab 3" },
    { "type": "text", "id": "man_tab3_label", "label": "Tab label", "default": "Socks" },
    { "type": "header", "content": "Womens — Tab 1" },
    { "type": "text", "id": "woman_tab1_label", "label": "Tab label", "default": "Top" },
    { "type": "header", "content": "Womens — Tab 2" },
    { "type": "text", "id": "woman_tab2_label", "label": "Tab label", "default": "Bottoms" },
    { "type": "header", "content": "Womens — Tab 3" },
    { "type": "text", "id": "woman_tab3_label", "label": "Tab label", "default": "Socks" }
  ],
  "presets": [{ "name": "Bundle Picker — Train" }]
}
{% endschema %}
