
{% unless product.metafields.custom.pdp_wear_it_with.value == blank %}
  {%- liquid
    assign title = section.settings.heading | default: 'Wear It With'

  -%}
  {%- capture products -%}
    [
    {%- for metafield_product in product.metafields.custom.pdp_wear_it_with.value %}
      {%- render 'json-product', product: metafield_product -%}
      {%- unless forloop.last -%},{%- endunless -%}
    {% endfor %}
    ]
  {%- endcapture -%}
  <wear-it-with
    x-title='{{ title | escape }}'
    products='{{ products | escape }}'
  >
    <section class='tw-w-full tw-pt-4 tw-overflow-x-hidden'>
      <div class='tw-flex tw-items-center tw-justify-between tw-mb-5 lg:tw-mb-8 tw-px-4 md:tw-px-12'>
        <h2 class='tw-text-base lg:tw-text-lg tw-font-normal tw-leading-6 tw-uppercase'>
          {{ title }}
        </h2>
      </div>
      <div class='tw-grid tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-2 tw-px-2 md:tw-px-12'>
        {% for metafield_product in product.metafields.custom.pdp_wear_it_with.value %}
          {% render 'html-product-skeleton' %}
        {% endfor %}
      </div>
    </section>
  </wear-it-with>

{% endunless %}

{% schema %}
{
  "name": "F.A. Wear It With",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear It With"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Select a product to display its metafields"
    }
  ],
  "presets": [
    {
      "category": "Product",
      "name": "F.A. Wear It With"
    }
  ]
}
{% endschema %}
