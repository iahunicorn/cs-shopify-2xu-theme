<div class='Container Container--narrow Container--account-dashboard'>
  <div class='PageLayout PageLayout--sidebar account-sidebar'>
    {% render 'account-navigation' %}
  </div>

  <div class='PageLayout--dashboard'>
    <h1 class='account-title'>{{ 'customer.account.title' | t }}</h1>
    {% render 'image-grid' %}
  </div>
</div>

{% if shop.permanent_domain == '2xu-australia.myshopify.com'
  or shop.permanent_domain == '2xu-nz.myshopify.com'
  or shop.permanent_domain == '2xu-ca.myshopify.com'
  or shop.permanent_domain == '2xu-us.myshopify.com'
%}
  <script>
    function fbq_track() {
      if (sessionStorage.getItem('fbq_track')) {
        let c_email = '{{ customer.email }}';
        s_email = sessionStorage.getItem('fbq_track');
        if (c_email == s_email) {
          fbq('track', 'Lead');
          sessionStorage.removeItem('fbq_track');
        }
      }
    }
    document.addEventListener('DOMContentLoaded', fbq_track);
  </script>
{% endif %}

