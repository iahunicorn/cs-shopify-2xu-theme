{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'section-collection-description.css' | asset_url | stylesheet_tag }}
<script
  src='{{ 'section-description-readmore.js' | asset_url }}'
  defer='defer'
></script>

{% liquid
  assign title = collection.metafields.description.title_description
  assign description = collection.metafields.description.content.html
%}
<div class='container'>
  <div class='collection-description'>
    {%- if title != blank -%}
      <div class='title-description'>{{ title }}</div>
    {%- endif -%}
    {%- if description != blank -%}
      <span class='content-description'>{{ description }}</span>
      <span class='second-description'></span>
      <span class='less-text'>...</span>
      <a href='#readmore' class='button-readmore'>
        {{- 'general.collections.read_more' | t -}}
      </a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Collection description",
  "class": "section",
  "presets": [
    {
      "name": "Collection description"
    }
  ]
}
{% endschema %}
