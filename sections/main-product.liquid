{{ 'component-fa-pdp.css' | asset_url | stylesheet_tag }}
{% liquid
  # Relative to entrypointsDir
  render 'vite-tag' with 'pdp.js'
  assign sizeGuideExists = false
  assign gender = 'unisex'

  assign singleVariant = false
  if product.has_only_default_variant or product.variants.size <= 1
    assign singleVariant = true
  endif

  for tag in product.tags
    assign downcased_tag = tag | downcase
    if downcased_tag == 'womens'
      assign gender = 'womens'
    endif
    if downcased_tag == 'mens'
      assign gender = 'mens'
    endif
    if downcased_tag == 'unisex'
      assign gender = 'unisex'
    endif
  endfor

  assign downcased_tags = product.tags | downcase

  if downcased_tags contains 'unisex'
    assign gender = 'unisex'
  endif

  assign stitchedProductsUsed = false
  for collection in product.collections
    assign collectionHandleParts = collection.handle | split: '-'
    if collectionHandleParts[0] == 'stitch'
      assign stitchedProductsUsed = true
      break
    endif
  endfor

  assign size_chart_page = ''
  for block in section.blocks
    assign verb = block.type
    if block.type == 'size-guide'
      assign productTypeArray = block.settings.product_type | split: ','
      for item in productTypeArray
        if item == product.type and block.settings.size_guide_gender == gender
          assign sizeGuideExists = true
          assign size_chart_page = pages[block.settings.size_guide_page]
          assign popupType = block.settings.size_guide_popup_type
        endif
      endfor
    endif
  endfor
%}

{%- assign size_label = 'size,taille,größe,tamanho,tamaño,koko,サイズ'
  | split: ','
-%}
<section>
  <script src='{{ 'product-form.js' | asset_url }}' defer='defer'></script>
  <div class='tw-relative tw-min-h-[calc(80svh-97px)] lg:tw-min-h-[calc(100svh-121px)]'>
    <div class='tw-absolute tw-z-20 tw-top-4 tw-left-4 lg:tw-top-6 lg:tw-left-10 tw-w-[calc(100%-1rem)]'>
      {% render 'flux-breadcrumb' %}
    </div>
    <div class='tw-hidden lg:tw-block lg:tw-absolute tw-bottom-10 tw-left-12 tw-z-10'>
      <div class='tw-flex tw-pb-4 tw-gap-1 [&>span]:!tw-font-input-mono'>
        {% if product.selected_or_first_available_variant.compare_at_price > 0
        %}
          {% liquid
            assign percent_sale = 0
            assign sale_price = product.selected_or_first_available_variant.compare_at_price
            assign old_price = product.selected_or_first_available_variant.price
            assign percent_sale = sale_price | minus: old_price | times: 100 | divided_by: sale_price
            assign percent_sale_custom = percent_sale | modulo: 5
            assign percent_sale_final = percent_sale | minus: percent_sale_custom
          %}
          {% if percent_sale_final >= 5 %}
            <span class='tw-px-3 tw-py-1 tw-rounded-full tw-text-2xu-white tw-bg-cyan-500'>
              -{{ percent_sale_final | append: '%' }}
            </span>
          {% endif %}
        {% endif %}
        {%- for tag in product.tags -%}
          {%- if tag contains 'sale-badge' -%}
            {% assign sale_tag = tag | split: ':' %}
            {%- if sale_tag[2] != blank -%}
              {%- assign badge_style = 'style="background-color:'
                | append: sale_tag[2]
                | append: ';'
              -%}
              {%- if sale_tag[3] != blank -%}
                {%- assign badge_style = badge_style
                  | append: ' color:'
                  | append: sale_tag[3]
                  | append: ';'
                -%}
              {%- endif -%}
            {%- endif -%}
            <div
              class='tw-px-3 tw-py-1 tw-rounded-full'
              {{ badge_style | append: '"' }}
            >
              {{ sale_tag[1] }}
            </div>
          {%- endif -%}
          {%- if tag contains 'exclusive-badge' -%}
            {% assign exclusive_tag = tag | split: ':' %}
            {%- if exclusive_tag[2] != blank -%}
              {%- assign exclusive_badge_style = 'style="background-color:'
                | append: exclusive_tag[2]
                | append: ';'
              -%}
              {%- if exclusive_tag[3] != blank -%}
                {%- assign exclusive_badge_style = exclusive_badge_style
                  | append: ' color:'
                  | append: exclusive_tag[3]
                  | append: ';'
                -%}
              {%- endif -%}
            {%- endif -%}
            <div
              class='tw-px-3 tw-py-1 tw-rounded-full'
              {{ exclusive_badge_style | append: '"' }}
            >
              {{ exclusive_tag[1] }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              <h1 class='tw-max-w-lg tw-text-[40px] tw-text-2xu-white tw-leading-10 tw-tracking-[0.4px] tw-uppercase [text-shadow:_0_0_20px_rgb(0_0_0_/_50%)] tw-mb-2'>
                {{ product.title | escape }}
              </h1>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
    <product-image-gallery
      data-product-images='{{product.media | json | escape }}'
    ></product-image-gallery>
  </div>
  <div class='tw-mx-4 md:tw-mx-12 tw-my-4 lg:tw-mt-6 lg:tw-mb-12 tw-flex tw-flex-col gap-2'>
    <div class='tw-flex lg:tw-hidden tw-gap-1 [&>span]:!tw-font-input-mono'>
      {% if product.selected_or_first_available_variant.compare_at_price > 0 %}
        {% liquid
          assign percent_sale = 0
          assign sale_price = product.selected_or_first_available_variant.compare_at_price
          assign old_price = product.selected_or_first_available_variant.price
          assign percent_sale = sale_price | minus: old_price | times: 100 | divided_by: sale_price
          assign percent_sale_custom = percent_sale | modulo: 5
          assign percent_sale_final = percent_sale | minus: percent_sale_custom
        %}
        {% if percent_sale_final >= 5 %}
          <span class='tw-px-3 tw-py-1 tw-rounded-full tw-text-2xu-white tw-bg-cyan-500'>
            -{{ percent_sale_final | append: '%' }}
          </span>
        {% endif %}
      {% endif %}
      {%- for tag in product.tags -%}
        {%- if tag contains 'sale-badge' -%}
          {% assign sale_tag = tag | split: ':' %}
          {%- if sale_tag[2] != blank -%}
            {%- assign badge_style = 'style="background-color:'
              | append: sale_tag[2]
              | append: ';'
            -%}
            {%- if sale_tag[3] != blank -%}
              {%- assign badge_style = badge_style
                | append: ' color:'
                | append: sale_tag[3]
                | append: ';'
              -%}
            {%- endif -%}
          {%- endif -%}
          <div
            class='tw-px-3 tw-py-1 tw-rounded-full'
            {{ badge_style | append: '"' }}
          >
            {{ sale_tag[1] }}
          </div>
        {%- endif -%}
        {%- if tag contains 'exclusive-badge' -%}
          {% assign exclusive_tag = tag | split: ':' %}
          {%- if exclusive_tag[2] != blank -%}
            {%- assign exclusive_badge_style = 'style="background-color:'
              | append: exclusive_tag[2]
              | append: ';'
            -%}
            {%- if exclusive_tag[3] != blank -%}
              {%- assign exclusive_badge_style = exclusive_badge_style
                | append: ' color:'
                | append: exclusive_tag[3]
                | append: ';'
              -%}
            {%- endif -%}
          {%- endif -%}
          <div
            class='tw-px-3 tw-py-1 tw-rounded-full'
            {{ exclusive_badge_style | append: '"' }}
          >
            {{ exclusive_tag[1] }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {% comment %} Block section 1 {% endcomment %}
    <div class='lg:tw-flex tw-w-full'>
      <div class='tw-w-full lg:tw-w-1/2 tw-pb-8 md:tw-pb-12 lg:tw-pb-0'>
        <star-rating></star-rating>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'title' -%}
              <h1 class='lg:tw-hidden tw-mt-1 tw-max-w-lg tw-text-xl tw-font-normal tw-text-2xu-black tw-leading-6 tw-uppercase tw-mb-2'>
                {{ product.title | escape }}
              </h1>
            {%- when 'price' -%}
              <div
                class='no-js-hidden tw-mb-6 lg:tw-mb-10'
                id='price-{{ section.id }}'
                role='status'
                {{ block.shopify_attributes }}
              >
                {%- render 'flux-price',
                  product: product,
                  use_variant: true,
                  settings: block.settings,
                  bnpl_icons: settings.bnpl_icons
                -%}
              </div>
            {%- when 'divider' -%}
              <span
                class='tw-my-4 tw-border-b tw-border-b-2xu-grey tw-w-full{% if block.settings.show_divider_desktop %} lg:tw-block{% else %} lg:tw-hidden{% endif %}{% if block.settings.show_divider_mobile %} tw-block{% else %} tw-hidden{% endif %}'
              ></span>
            {%- when 'color_picker' -%}
              {%- render 'flux-color-picker', product: product -%}
            {%- when 'description' -%}
              <div class='tw-max-w-md !tw-text-base [&_p]:tw-text-base [&_p]:tw-pb-2 [&_a]:tw-text-base tw-font-normal tw-leading-6 tw-my-5 md:tw-my-7'>
                {{ product.description }}
              </div>
            {%- when 'sku' -%}
              {%- if product.selected_or_first_available_variant.sku != blank
              -%}
                <p class='product__sku'>
                  {{ 'products.product.sku' | t }}:
                  <span class='ProductMeta__SkuNumber'>
                    {% assign sku_parts = product.selected_or_first_available_variant.sku
                      | split: '-'
                    %}
                    {% assign sku_parts_without_size_length = sku_parts.size
                      | minus: 1
                    %}
                    {% assign sku_without_size = sku_parts
                      | slice: 0, sku_parts_without_size_length
                      | join: '-'
                    %}
                    {{- sku_without_size -}}
                  </span>
                </p>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
      {% comment %} Block section 2 {% endcomment %}
      {%- assign product_form_id = 'product-form-' | append: section.id -%}
      <div class='tw-w-full lg:tw-w-1/2 tw-flex tw-flex-col lg:tw-items-end'>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'buy_buttons' -%}
              <div class='tw-flex tw-flex-col tw-w-full'>
                {%- form 'product',
                  product,
                  id: product_form_id,
                  class: 'form flux-ATC-form tw-flex tw-flex-col-reverse lg:tw-flex-col',
                  novalidate: 'novalidate',
                  data-type: 'add-to-cart-form'
                -%}
                  <div class='tw-flex tw-items-center tw-justify-end lg:tw-max-w-lg lg:tw-w-5/6 lg:tw-self-end'>
                    {% if settings.include_stock_in_store == true %}
                      <div class='tw-w-full lg:tw-flex-1 lg:tw-w-auto tw-flex tw-mt-2 lg:tw-mt-0 tw-bg-2xu-light-grey lg:tw-bg-transparent tw-items-center tw-justify-center lg:tw-justify-end lg:tw-ml-2'>
                        <div id='stockinstore-wrapper'></div>
                      </div>
                    {% endif %}
                    {% render 'flux-buy-buttons', block: block, product: product, show_size_guide_link: size_chart_page %}
                  </div>
                  <div class='tw-flex lg:tw-px-2 tw-mt-0 lg:tw-w-5/6 lg:tw-max-w-lg lg:tw-self-end'>
                    <div class='tw-w-full tw-flex tw-justify-center tw-flex-col tw-gap-2'>
                      {% assign show_disclaimer = false %}
                      {%- for tag in product.tags -%}
                        {% assign downcase_tag = tag | downcase %}
                        {%- if downcase_tag contains 'outlet' -%}
                          {% assign show_disclaimer = true %}
                        {%- endif -%}
                      {%- endfor -%}
                      {% if show_disclaimer %}
                        <div class='tw-rounded-flux tw-flex-grow tw-text-xs tw-font-euclid lg:tw-font-euclid lg:tw-text-xs tw-bg-2xu-light-grey tw-py-4 lg:tw-py-0 tw-text-2xu-black tw-h-14 md:tw-h-12 tw-px-7 tw-flex tw-items-center tw-w-full tw-justify-center tw-text-center tw-break-words'>
                          {{ section.settings.disclaimer }}
                        </div>
                      {% endif %}
                      <div class='tw-rounded-flux tw-flex-grow tw-text-sm tw-font-euclid lg:tw-font-euclid lg:tw-text-xs tw-bg-2xu-light-grey tw-py-4 lg:tw-py-0 tw-text-2xu-black tw-h-12 tw-px-7 tw-flex tw-items-center tw-w-full tw-justify-center tw-text-center tw-break-words'>
                        {{ block.settings.callout }}
                      </div>
                      {%- if section.settings.show_pickup_availability -%}
                        <div
                          class='ProductMeta__StoreAvailabilityContainer'
                        ></div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endform -%}
              </div>
            {%- when 'usp_block' -%}
              {% if product.metafields.custom.pdp_usp_icons.value %}
                <div class='tw-pt-3 tw-pb-6 lg:tw-pt-12 lg:tw-pb-0 tw-w-full'>
                  <usp-block
                    x-pdp-usp-blocks='
                      [
                        {% for usp in product.metafields.custom.pdp_usp_icons.value %}
                          {
                            "category": "{{ usp.category }}",
                            "display_name": "{{ usp.display_name }}",
                            "header": "{{ usp.header }}",
                            "icon": "{{ usp.icon | image_url: width: 150 }}",
                            {% if usp.modal_graph_text %}
                            "modal_graph_text": {{ usp.modal_graph_text }},
                            {% endif %}
                            "percentage": "{{ usp.percentage }}",
                            "popup_body_text": "{{ usp.popup_body_text | strip_newlines | escape }}"
                          }{% unless forloop.last %},{% endunless %}
                        {% endfor %}
                      ]
                    '
                  ></usp-block>
                </div>
              {% endif %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% assign popups = section.blocks | where: 'type', 'popup' %}
{%- for block in popups -%}
  <modal-dialog
    id='PopupModal-{{ block.id }}'
    class='product-popup-modal'
    {{ block.shopify_attributes }}
  >
    <div
      role='dialog'
      aria-label='{{ block.settings.text }}'
      aria-modal='true'
      class='product-popup-modal__content'
      tabindex='-1'
    >
      <button
        id='ModalClose-{{ block.id }}'
        type='button'
        class='product-popup-modal__toggle'
        aria-label='{{ 'accessibility.close' | t }}'
      >
        {% render 'icon-close' %}
      </button>
      <div class='product-popup-modal__content-info'>
        <h1 class='h2'>{{ block.settings.page.title }}</h1>
        {{ block.settings.page.content }}
      </div>
    </div>
  </modal-dialog>
{%- endfor -%}


{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

<script type='application/ld+json'>
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
    {% if product.metafields.okendo.summaryData.reviewCount > 0 %}
      ,"aggregateRating": {
      "@type": "AggregateRating",
      "description": "Okendo Reviews",
      "ratingValue": "{{ product.metafields.okendo.summaryData.reviewAverageValue }}",
      "ratingCount": "{{ product.metafields.okendo.summaryData.reviewCount }}"
      }
      {% elsif product.metafields.okendo.ReviewCount > 0 %}
      ,"aggregateRating": {
      "@type": "AggregateRating",
      "description": "Okendo Reviews",
      "ratingValue": "{{ product.metafields.okendo.ReviewAverageValue }}",
      "ratingCount": "{{ product.metafields.okendo.ReviewCount }}"
      }
      {% endif %}
  }
</script>


<div
  id='size-chart-content'
  class='hidden color-background-1 size-chart-popup {{ popupType }}'
>
  <div class='size-chart-popup-content'>
    <div class='size-chart-popup-title'>
      <h2 class=''>{{ size_chart_page.title }}</h2>
    </div>
    <div class='size-chart-popup-infor'>
      {{- size_chart_page.content -}}
    </div>
  </div>
</div>


{% if settings.klayvio_product %}
  <script type='text/javascript'>
    var _learnq = _learnq || [];

    var item = {
      Name: {{ product.title|json }},
      ProductID: {{ product.id|json }},
      Categories: {{ product.collections|map:'title'|json }},
      ImageURL: "https:{{ product.featured_image.src|img_url:'grande' }}",
      URL: "{{ shop.secure_url }}{{ product.url }}",
      Brand: {{ product.vendor|json }},
      Price: {{ product.price|money|json }},
      CompareAtPrice: {{ product.compare_at_price_max|money|json }}
    };

    _learnq.push(['track', 'Viewed Product', item]);
    _learnq.push(['trackViewedItem', {
      Title: item.Name,
      ItemId: item.ProductID,
      Categories: item.Categories,
      ImageUrl: item.ImageURL,
      Url: item.URL,
      Metadata: {
        Brand: item.Brand,
        Price: item.Price,
        CompareAtPrice: item.CompareAtPrice
      }
    }]);
  </script>
  <script type='text/javascript'>
    // Tracking moved to the Add to Cart button component
    var _learnq = _learnq || [];
    document
      .querySelector('.product-form__submit')
      ?.addEventListener('click', function () {
        _learnq.push(['track', 'Added to Cart', item]);
      });
  </script>
{% endif %}

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "size-guide",
      "name": "Size Guide",
      "settings": [
        {
          "type": "textarea",
          "id": "product_type",
          "label": "Product type",
          "info": "Must match case of actual product type. Separate multiple product types with a comma, no spaces except where product type is multiple words."
        },
        {
          "type": "page",
          "id": "size_guide_page",
          "label": "Size guide page"
        },
        {
          "type": "select",
          "id": "size_guide_gender",
          "label": "Product gender",
          "options": [
            {
              "value": "unisex",
              "label": "Unisex"
            },
            {
              "value": "womens",
              "label": "Womens"
            },
            {
              "value": "mens",
              "label": "Mens"
            }
          ]
        },
        {
          "type": "select",
          "id": "size_guide_popup_type",
          "label": "Show Popup Type",
          "options": [
            {
              "value": "simple",
              "label": "Simple"
            },
            {
              "value": "type-1",
              "label": "Type 1"
            },
            {
              "value": "type-2",
              "label": "Type 2"
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Text block",
          "label": "t:sections.main-product.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__2.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__3.label"
            }
          ],
          "default": "body",
          "label": "t:sections.main-product.blocks.text.settings.text_style.label"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-product.blocks.title.name",
      "limit": 1
    },
    {
      "type": "sku",
      "name": "Sku",
      "limit": 1
    },
    {
      "type": "extended_description",
      "name": "Extended Description",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.main-product.blocks.price.name",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Buy Now Pay Later"
        },
        {
          "type": "checkbox",
          "id": "show_bnpl_payments",
          "label": "Show BNPL Payments",
          "default": true
        },
        {
          "type": "number",
          "id": "bnpl_payments_divisor",
          "label": "BNPL payment divided by",
          "default": 4
        },
        {
          "type": "text",
          "id": "bnpl_payments_text",
          "label": "BNPL payment text",
          "default": "or $divisor payments of $bnpl_price with",
          "info": "Use $divisor and $bnpl_price to insert the values"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_divider_mobile",
          "label": "Show divider on mobile"
        },
        {
          "type": "checkbox",
          "id": "show_divider_desktop",
          "label": "Show divider on desktop"
        }
      ]
    },
    {
      "type": "list_icon",
      "name": "List icon",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_1",
          "label": "Icon 1"
        },
        {
          "type": "text",
          "id": "list_text_1",
          "label": "Text 1"
        },
        {
          "type": "image_picker",
          "id": "icon_2",
          "label": "Icon 2"
        },
        {
          "type": "text",
          "id": "list_text_2",
          "label": "Text 2"
