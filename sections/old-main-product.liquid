 </modal-dialog>
 <div class="Product__OffScreen">
   {{- product_popovers -}}
   {{- product_modals -}}
   <script>
     const tabLinks = document.querySelectorAll('.tablinks');
     const tabContent =document.querySelectorAll('.tabcontent');
     const buttonRight = document.querySelector('#cm #slide-right');
     const buttonLeft = document.querySelector('#cm #slide-left');
     const buttonRightInch = document.querySelector('#inch #slide-right');
     const buttonLeftInch = document.querySelector('#inch #slide-left');
     const tableCms = document.querySelector('#cm');
     const tableInch = document.querySelector('#inch');
     const tableInchs = document.querySelector('#inch');
     const inchTab = document.querySelector('.size-chart-popup-infor button[data-tabtype="inch"]');
     const cmTab = document.querySelector('.size-chart-popup-infor button[data-tabtype="cm"]')

     tabLinks.forEach(function(el) {
       el.addEventListener("click", openTabs);
     });

     function openTabs(el) {
       var btn = el.currentTarget;
       var tabtype = btn.dataset.tabtype;

       tabContent.forEach(function(el) {
         el.classList.remove('active');
       });

       tabLinks.forEach(function(el) {
         el.classList.remove('active');
       });

       document.querySelector('#' + tabtype).classList.add('active');

       btn.classList.add('active');
     }

     setDefaultTabBasedOffRegion();

     function setDefaultTabBasedOffRegion() {
       {% comment %} Turn on Inches and hide CM based off region {% endcomment %}
       if (Shopify.shop == '2xu-ca.myshopify.com' || Shopify.shop == '2xu-us.myshopify.com') {
         inchTab.classList.add('active');
         tableInch.classList.add('active');
         cmTab.classList.remove('active');
         tableCms.classList.remove('active');
       }
     };

     var tabcontent2 = document.querySelectorAll('.tabcontent');

     tabcontent2.forEach(function(el) {

       buttonRight.onclick = () => {
         tableCms.scrollLeft += 20;
       };
       buttonLeft.onclick = () => {
         tableCms.scrollLeft -= 20;
       };
       buttonRightInch.onclick = () => {
         tableInch.scrollLeft += 20;
       };
       buttonLeftInch.onclick = () => {
         tableInch.scrollLeft -= 20;
       };
     });

     tableCms.addEventListener("scroll", checkScrollCM);
     function checkScrollCM() {
       var containerCm = tableCms.clientWidth;
       var tableCm = tableCms.scrollWidth;
       var tableCmScroll = tableCms.scrollLeft;
       tableCm -= tableCmScroll;
       if (containerCm >= tableCm) {
         buttonRight.style.display = 'none';
       } else if(tableCmScroll == 0) {
         buttonLeft.style.display = 'none';
       } else if (containerCm > tableCm && tableCmScroll == 0) {
         buttonRight.style.display = 'none';
         buttonLeft.style.display = 'none';
       } else {
         buttonRight.style.display = 'flex';
         buttonLeft.style.display = 'flex';
       }
     }

     hideCmArrow();

     window.addEventListener("resize", hideCmArrow);

     function hideCmArrow() {
       var containerCmLoad = tableCms.clientWidth;
       var tableCmLoad = tableCms.scrollWidth;
       var tableCmScrollLoad = tableCms.scrollLeft;
       if (containerCmLoad >= tableCmLoad) {
         buttonRight.style.display = 'none';
         buttonLeft.style.display = 'none';
       } else if (tableCmScrollLoad == 0 && containerCmLoad < tableCmLoad) {
         buttonLeft.style.display = 'none';
         buttonRight.style.display = 'flex';
       } else if (containerCmLoad < tableCmLoad) {
         buttonRight.style.display = 'flex';
         buttonLeft.style.display = 'flex';
       }
     };

     tableInch.addEventListener("scroll", checkScrollInch);
     function checkScrollInch() {
       var containerInch = tableInch.clientWidth;
       var tableInchs = tableInch.scrollWidth;
       var tableInchScroll = tableInch.scrollLeft;
       tableInchs -= tableInchScroll;

       if (containerInch >= tableInchs) {
         buttonRightInch.style.display = 'none';
       } else if(tableInchScroll == 0) {
         buttonLeftInch.style.display = 'none';
       } else {
         buttonRightInch.style.display = 'flex';
         buttonLeftInch.style.display = 'flex';
       }
     }

     hideInchArrow();

     window.addEventListener("resize", hideInchArrow);

     function hideInchArrow() {
       var containerInchLoad = tableCms.clientWidth;
       var tableInchLoad = tableCms.scrollWidth;
       var tableInchScrollLoad = tableCms.scrollLeft;
       if (containerInchLoad >= tableInchLoad) {
         buttonRightInch.style.display = 'none';
         buttonLeftInch.style.display = 'none';
       } else if (tableInchScrollLoad == 0 && containerInchLoad < tableInchLoad) {
         buttonLeftInch.style.display = 'none';
         buttonRightInch.style.display = 'flex';
       } else if (containerInchLoad < tableInchLoad) {
         buttonRightInch.style.display = 'flex';
         buttonLeftInch.style.display = 'flex';
       }
     };

     checkHover(tableCms);
     checkHover(tableInchs);

     function checkHover(table) {
       // Get all the rows in the table
       var rows = table.getElementsByTagName('tr');

       for (var i = 0; i < rows.length; i++) {
         //Get the cells in the given row
         var cells = rows[i].getElementsByTagName('td');
         for (var j = 0; j < cells.length; j++) {
             // Cell Object
             var cell = cells[j];
             cell.rowIndex = i;
             cell.positionIndex = j;
             cell.totalCells = cells.length;
             cell.totalRows = rows.length;

             cell.onmouseover = function () {
               var indexCell = document.querySelectorAll('tr td:nth-child('+(this.positionIndex + 1)+')' );
               indexCell.forEach(function (el) {
                 el.classList.add('hover-cell');
               });
             };
             cell.onmouseout = function () {
               var indexCell = document.querySelectorAll('tr td:nth-child('+(this.positionIndex + 1)+')' );
               indexCell.forEach(function (el) {
                 el.classList.remove('hover-cell');
               });
             };
         }
       }
     }

   </script>
 </div>
 {% if settings.klayvio_product %}
   <script type="text/javascript">
     var _learnq = _learnq || [];

     var item = {
       Name: {{ product.title|json }},
       ProductID: {{ product.id|json }},
       Categories: {{ product.collections|map:'title'|json }},
       ImageURL: "https:{{ product.featured_image.src|img_url:'grande' }}",
       URL: "{{ shop.secure_url }}{{ product.url }}",
       Brand: {{ product.vendor|json }},
       Price: {{ product.price|money|json }},
       CompareAtPrice: {{ product.compare_at_price_max|money|json }}
     };

     _learnq.push(['track', 'Viewed Product', item]);
     _learnq.push(['trackViewedItem', {
       Title: item.Name,
       ItemId: item.ProductID,
       Categories: item.Categories,
       ImageUrl: item.ImageURL,
       Url: item.URL,
       Metadata: {
         Brand: item.Brand,
         Price: item.Price,
         CompareAtPrice: item.CompareAtPrice
       }
     }]);
   </script>
   <script type="text/javascript">
     var _learnq = _learnq || [];
     document.querySelector('.product-form__submit.button.button--full-width.button--primary').addEventListener('click',function (){
       _learnq.push(['track', 'Added to Cart', item]);
     });
   </script>
 {% endif %}

